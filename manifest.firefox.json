{
  "manifest_version": 3,
  "name": "Web Performance Auditor",
  "version": "0.3.0",
  "description": "Диагностика Core Web Vitals (LCP, CLS, INP, FCP, TTFB) веб-страниц",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "service-worker-loader.js"
    ],
    "type": "module"
  },
  "sidebar_action": {
    "default_title": "Web Performance Auditor",
    "default_panel": "src/sidepanel/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "action": {
    "default_title": "Web Performance Auditor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-performance-auditor@wwsxdc.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
