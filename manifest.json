{
  "manifest_version": 3,
  "name": "Web Performance Auditor",
  "version": "0.4.1",
  "minimum_chrome_version": "116",
  "description": "Диагностика Core Web Vitals (LCP, CLS, INP, FCP, TTFB) веб-страниц",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Web Performance Auditor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
